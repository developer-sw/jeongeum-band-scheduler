[Unit]
Description=JEONGEUM operational database encrypted backup
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
ConditionPathExists=/etc/jeongeum-operational-backup/config.json

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
# The command waits up to 120s for the exact existing PG source before AWS/snapshot.
# Readiness is included in this service's total TimeoutStartSec; direct CLI is guarded too.
ExecStart=/usr/bin/python3 -I -B /opt/jeongeum/operational-backup/operational-backup.py backup --config /etc/jeongeum-operational-backup/config.json
TimeoutStartSec=20min
TimeoutStopSec=30s
KillMode=control-group
StateDirectory=jeongeum-operational-backup
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jeongeum-operational-backup
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=512M
TasksMax=64
LimitNOFILE=1024
LimitFSIZE=300M
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
StandardOutput=journal
StandardError=journal

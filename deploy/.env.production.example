# Copy outside Git, then fill real values. These are NOT credentials or a live deployment.
COMPOSE_PROJECT_NAME=jeongeum-production
APP_DOMAIN=example.invalid
ACME_EMAIL=operator@example.invalid
BACKEND_IMAGE=jeongeum-backend:REPLACE_WITH_TESTED_RELEASE
FRONTEND_IMAGE=jeongeum-frontend:REPLACE_WITH_TESTED_RELEASE
CADDY_IMAGE=jeongeum-caddy:REPLACE_WITH_TESTED_RELEASE
POSTGRES_DB=jeongeum_prod
APP_DB_USERNAME=jeongeum_app
APP_NETWORK_SUBNET=172.30.220.0/24
CADDY_INTERNAL_IP=172.30.220.10
APP_TRUSTED_PROXY_REGEX=172[.]30[.]220[.]10
# Linux runtime copies from runtime-secrets.py; master values stay root-only elsewhere.
# Use compose.production.yaml + compose.runtime-secrets.yaml together (Compose >= 2.24.4).
POSTGRES_ADMIN_PASSWORD_FILE=/absolute/private/runtime/postgres-admin-password.txt
POSTGRES_APP_DB_PASSWORD_FILE=/absolute/private/runtime/postgres-app-db-password.txt
APP_DB_PASSWORD_FILE=/absolute/private/runtime/app-db-password.txt
VAPID_PUBLIC_KEY_FILE=/absolute/private/runtime/vapid-public-key.txt
VAPID_PRIVATE_KEY_FILE=/absolute/private/runtime/vapid-private-key.txt
VAPID_SUBJECT_FILE=/absolute/private/runtime/vapid-subject.txt
# Empty VAPID files are permitted only while Push is disabled. No existing subscriptions migrate automatically.
JEONGEUM_RECURRING_WORKER_ENABLED=false
JEONGEUM_EXCHANGE_WORKER_ENABLED=false
JEONGEUM_REMINDER_WORKER_ENABLED=false
JEONGEUM_PUSH_WORKER_ENABLED=false
JEONGEUM_PUSH_ENABLED=false

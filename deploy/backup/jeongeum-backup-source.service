[Unit]
Description=JEONGEUM existing synthetic PostgreSQL backup source readiness
After=docker.service
Requires=docker.service
Before=jeongeum-backup.service
ConditionPathExists=/etc/jeongeum-backup/config.json

[Service]
Type=oneshot
RemainAfterExit=true
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 -I /opt/jeongeum/backup/backup-source-readiness.py --config /etc/jeongeum-backup/config.json
TimeoutStartSec=3min
TimeoutStopSec=15s
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=128M
TasksMax=32
LimitNOFILE=512
LimitFSIZE=1M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

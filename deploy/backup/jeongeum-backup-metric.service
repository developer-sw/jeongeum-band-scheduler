[Unit]
Description=JEONGEUM verified backup age metric
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/jeongeum-backup/config.json

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 -I /opt/jeongeum/backup/production-backup.py metric --config /etc/jeongeum-backup/config.json
TimeoutStartSec=4min
TimeoutStopSec=15s
KillMode=control-group
StateDirectory=jeongeum-backup
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jeongeum-backup
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=256M
TasksMax=32
LimitNOFILE=512
LimitFSIZE=1M
StandardOutput=journal
StandardError=journal
